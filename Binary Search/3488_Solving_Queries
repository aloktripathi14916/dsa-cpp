/*
Problem: Solve Queries
Platform: LeetCode (LC 3488)
Topic: Arrays / Binary Search / HashMap

---------------------------------------------------------

Approach:

For every query index q,
we need to find the minimum circular distance
to another occurrence of the same value.

Idea:
1. Store all indices of every number
   using a hashmap:
        value -> sorted list of indices

2. For a query:
      - Find position of q in its index list
        using binary search.
      - Check:
            previous occurrence
            next occurrence
      - Since array is circular,
        neighbors are taken modulo size.

3. Compute circular distance:
      min(d, n - d)

Why only previous and next?
- Closest occurrence in a sorted circular list
  must be one of the adjacent occurrences.

---------------------------------------------------------

Time Complexity:
- Building map: O(n)
- Each query: O(log n)

Overall:
O(n + q log n)

Space Complexity: O(n)

Example:
Input:
nums = [1,3,1,4,1]
queries = [0,1,2]

Output:
[2,-1,2]

Explanation:
For index 0:
same values at indices 2 and 4
minimum circular distance = 2
*/

class Solution {
public:
    vector<int> solveQueries(vector<int>& nums,
                             vector<int>& queries) {

        int n = nums.size();

        unordered_map<int, vector<int>> mp;

        // Store indices of every value
        for (int i = 0; i < n; i++) {

            mp[nums[i]].push_back(i);
        }

        vector<int> ans;

        // Process each query
        for (int q : queries) {

            int val = nums[q];

            auto &vec = mp[val];

            // Only one occurrence exists
            if (vec.size() == 1) {

                ans.push_back(-1);
                continue;
            }

            // Find position of q in index list
            int pos =
                lower_bound(vec.begin(),
                            vec.end(),
                            q) - vec.begin();

            // Circular neighbors
            int next =
                vec[(pos + 1) % vec.size()];

            int prev =
                vec[(pos - 1 + vec.size()) % vec.size()];

            // Direct distances
            int d1 = abs(next - q);
            int d2 = abs(prev - q);

            // Circular minimum distance
            int res =
                min(min(d1, n - d1),
                    min(d2, n - d2));

            ans.push_back(res);
        }

        return ans;
    }
};

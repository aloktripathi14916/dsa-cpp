/*
Problem: Implement Stack using Queues
Platform: LeetCode (LC 225)
Topic: Queue / Stack Design

---------------------------------------------------------

Approach:

A stack follows:

    LIFO
    (Last In First Out)

A queue follows:

    FIFO
    (First In First Out)

We need to simulate stack operations
using only queues.

---------------------------------------------------------

Idea:

Maintain q1 such that:

- Top element of the stack is always
  at the front of q1.

To achieve this:

During push(x):

1. Move all elements from q1 to q2.
2. Insert x into q1.
3. Move all elements from q2 back to q1.

Result:

Newest element always remains
at the front of q1.

---------------------------------------------------------

Example:

push(1)

q1 = [1]

push(2)

Move:
q1 -> q2

q2 = [1]

Insert 2 into q1

q1 = [2]

Move back:

q1 = [2,1]

Front = 2
(Stack top)

---------------------------------------------------------

Operations:

push(x)

Move existing elements aside,
insert x first,
then restore previous elements.

---------------------------------------------------------

pop()

Since stack top is always at the front:

    return q1.front()

and remove it.

---------------------------------------------------------

top()

Return:

    q1.front()

---------------------------------------------------------

empty()

Return:

    q1.empty()

---------------------------------------------------------

Time Complexity:

push()  -> O(n)
pop()   -> O(1)
top()   -> O(1)
empty() -> O(1)

Space Complexity: O(n)

---------------------------------------------------------

Example:

push(1)
push(2)

Stack:

Top -> 2
       1

top() -> 2

pop() -> 2

top() -> 1
*/

class MyStack {
public:

    queue<int> q1;
    queue<int> q2;

    MyStack() {

    }

    void push(int x) {

        // Move all elements to q2
        while (!q1.empty()) {

            q2.push(q1.front());

            q1.pop();
        }

        // Insert new element
        q1.push(x);

        // Move elements back
        while (!q2.empty()) {

            q1.push(q2.front());

            q2.pop();
        }
    }

    int pop() {

        int ans = q1.front();

        q1.pop();

        return ans;
    }

    int top() {

        return q1.front();
    }

    bool empty() {

        return q1.empty();
    }
};


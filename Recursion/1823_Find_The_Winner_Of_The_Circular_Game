/*
Problem: Find the Winner of the Circular Game (LC 1823)
Topic: Recursion, Josephus Problem

--------------------------------------------------

Idea:

For n people, the winner's zero-based index
can be found using:

    J(n, k) = (J(n - 1, k) + k) % n

Base case:

    J(1, k) = 0

The recurrence gives the answer using
0-based indexing, so we add 1 at the end.

--------------------------------------------------

Time: O(n)

There is one recursive call for every n.

Space: O(n)

Due to the recursion stack.

--------------------------------------------------
*/

class Solution {
public:

    int recursion(int n, int k) {

        if(n == 1)
            return 0;

        return (recursion(n - 1, k) + k) % n;
    }

    int findTheWinner(int n, int k) {

        return recursion(n, k) + 1;
    }
};

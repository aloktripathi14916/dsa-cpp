/*
Problem: Maximum Width of Binary Tree (LC 662)
Topic: Binary Tree / BFS

--------------------------------------------------

Idea:

The width of a level is the distance
between the leftmost and rightmost
non-null nodes, including the null
positions in between.

Assign every node an index as if the
tree were stored in an array.

Indexing:

Root  = 0

Left  = 2*i + 1

Right = 2*i + 2

At each level,

Width = lastIndex - firstIndex + 1

--------------------------------------------------

Algorithm:

1. Push (root, index = 0) into queue.

2. For every level:

   • Store first index.

   • Store last index.

   • Compute current width.

3. Push children with their
   corresponding indices.

4. Return the maximum width found.

--------------------------------------------------

Example:

          1
        /   \
       3     2
      /       \
     5         9

Indices:

          0
        /   \
       1     2
      /       \
     3         6

Width = 6 - 3 + 1 = 4

--------------------------------------------------

Why It Works?

The assigned indices represent the
positions nodes would occupy in a
complete binary tree.

Therefore,

lastIndex - firstIndex + 1

correctly counts both existing nodes
and the gaps between them.

--------------------------------------------------

Time : O(n)

Every node is visited once.

Space : O(n)

Queue stores one level at a time.

--------------------------------------------------

Pattern:

Binary Tree BFS + Complete Tree Indexing
*/

class Solution {
public:
    int widthOfBinaryTree(TreeNode* root) {

        queue<pair<TreeNode*, unsigned long long>> q;

        q.push({root, 0});

        int maxWidth = 0;

        while (!q.empty()) {

            int levelSize = q.size();

            unsigned long long firstIdx = q.front().second;
            unsigned long long lastIdx  = q.back().second;

            // Width of current level
            maxWidth = max(maxWidth,
                           (int)(lastIdx - firstIdx + 1));

            for (int i = 0; i < levelSize; i++) {

                auto curr = q.front();
                q.pop();

                if (curr.first->left) {
                    q.push({curr.first->left,
                            curr.second * 2 + 1});
                }

                if (curr.first->right) {
                    q.push({curr.first->right,
                            curr.second * 2 + 2});
                }
            }
        }

        return maxWidth;
    }
};

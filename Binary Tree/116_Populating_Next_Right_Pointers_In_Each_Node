/*
Problem: Populating Next Right Pointers in Each Node (LC 116)
Topic: Binary Tree, BFS

--------------------------------------------------

Idea:

Perform a level order traversal.

Use NULL as a level marker.

• Connect the previous node of the
  current level to the current node.

• When NULL is reached, the current
  level ends. Push another NULL if
  more nodes remain.

Thus, every node's next pointer points
to its immediate right neighbor.

--------------------------------------------------

Time: O(n)

Space: O(n)

--------------------------------------------------
*/

class Solution {
public:
    Node* connect(Node* root) {

        if(root == NULL || root->left == NULL)
            return root;

        queue<Node*> q;
        q.push(root);
        q.push(NULL);

        Node* prev = NULL;

        while(!q.empty()) {

            Node* curr = q.front();
            q.pop();

            if(curr == NULL) {

                if(q.empty())
                    break;

                q.push(NULL);
            }
            else {

                if(curr->left)
                    q.push(curr->left);

                if(curr->right)
                    q.push(curr->right);

                if(prev)
                    prev->next = curr;
            }

            prev = curr;
        }

        return root;
    }
};

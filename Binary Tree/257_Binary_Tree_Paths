/*
Problem: Binary Tree Paths (LC 257)
Topic: Binary Tree / DFS / Backtracking

--------------------------------------------------

Idea:

Start from the root and recursively
traverse every root-to-leaf path.

Maintain a string representing the
current path.

Whenever a leaf node is reached,
store the complete path in the answer.

--------------------------------------------------

Algorithm:

1. Start path with the root value.

2. At each node,
   append "->child" to the path.

3. Recur for left and right child.

4. If a leaf node is reached,
   add the path to the answer.

--------------------------------------------------

Example:

        1
       / \
      2   3
       \
        5

Paths:

1->2->5

1->3

Answer:

["1->2->5",
 "1->3"]

--------------------------------------------------

Why It Works?

Every recursive call carries the
complete path from the root to the
current node.

When a leaf is reached, that path is
a valid root-to-leaf path and is
stored in the result.

--------------------------------------------------

Time : O(n)

Every node is visited once.

Space : O(h)

h = height of tree (recursion stack)

Extra space is used to store the
output paths.

--------------------------------------------------

Pattern:

Tree DFS + Backtracking
*/

class Solution {
public:

    void allPaths(TreeNode* root,
                  string path,
                  vector<string>& ans) {

        // Leaf node
        if (root->left == NULL &&
            root->right == NULL) {

            ans.push_back(path);
            return;
        }

        // Traverse left subtree
        if (root->left) {
            allPaths(root->left,
                     path + "->" +
                     to_string(root->left->val),
                     ans);
        }

        // Traverse right subtree
        if (root->right) {
            allPaths(root->right,
                     path + "->" +
                     to_string(root->right->val),
                     ans);
        }
    }

    vector<string> binaryTreePaths(TreeNode* root) {

        vector<string> ans;

        string path = to_string(root->val);

        allPaths(root, path, ans);

        return ans;
    }
};


/*
Problem: Minimum Number of Pushes to Type Word I
LeetCode: 3014

--------------------------------------------------

Idea:
There are 8 keys, so:
- First 8 characters cost 1 push each.
- Next 8 characters cost 2 pushes each.
- Next 8 characters cost 3 pushes each.
- And so on.

For the i-th character (0-indexed), its minimum
number of pushes is (i / 8) + 1.

--------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)
*/

class Solution {
public:
    int minimumPushes(string word) {
        int ans = 0;

        for (int i = 0; i < word.size(); i++) {
            ans += (i / 8) + 1;
        }

        return ans;
    }
};

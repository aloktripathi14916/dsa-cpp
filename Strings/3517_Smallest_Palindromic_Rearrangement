
/*
Problem: Smallest Palindromic Rearrangement
LeetCode: 3517

--------------------------------------------------

Idea:
1. Count the frequency of each character.
2. Build the left half using freq[i] / 2 copies.
   Since we process from 'a' to 'z', the left half
   is automatically lexicographically smallest.
3. If a character has an odd frequency, place it in
   the middle.
4. Mirror the left half to create the right half.

--------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(n)
*/

class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> freq(26, 0);

        // Count character frequencies
        for (char c : s)
            freq[c - 'a']++;

        string left = "";
        string mid = "";

        // Build the left half
        for (int i = 0; i < 26; i++) {
            left.append(freq[i] / 2, char('a' + i));

            // Only one character can have an odd frequency
            if (freq[i] % 2)
                mid = char('a' + i);
        }

        // Mirror the left half
        string right = left;
        reverse(right.begin(), right.end());

        return left + mid + right;
    }
};

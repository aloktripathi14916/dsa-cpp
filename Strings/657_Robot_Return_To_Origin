/*
Problem: Robot Return to Origin (LC 657)
Topic: String, Simulation

--------------------------------------------------

Idea:

Maintain the robot's position using two variables:

    U -> row/vertical position increases
    D -> row/vertical position decreases
    R -> column/horizontal position increases
    L -> column/horizontal position decreases

If the robot ends at (0, 0), it returned to
the origin.

--------------------------------------------------

Time: O(n)

Space: O(1)

--------------------------------------------------
*/

class Solution {
public:
    bool judgeCircle(string moves) {

        int a = 0;
        int b = 0;

        for(char ch : moves) {

            if(ch == 'U')
                a++;

            else if(ch == 'D')
                a--;

            else if(ch == 'R')
                b++;

            else if(ch == 'L')
                b--;
        }

        return a == 0 && b == 0;
    }
};

/*
Problem: Array Partition (LC 561)
Topic: Sorting, Greedy

--------------------------------------------------

Idea:

We need to divide the array into pairs and
maximize the sum of the minimum element of
each pair.

Sort the array.

After sorting, the optimal pairing is:

    (nums[0], nums[1])
    (nums[2], nums[3])
    (nums[4], nums[5])
    ...

The minimum of each pair is therefore every
even-indexed element.

--------------------------------------------------

Time: O(n log n)

Sorting dominates.

Space: O(1) extra (ignoring sort internals).

--------------------------------------------------
*/

class Solution {
public:
    int arrayPairSum(vector<int>& nums) {

        sort(nums.begin(), nums.end());

        int sum = 0;

        for(int i = 0; i < nums.size(); i += 2)
            sum += nums[i];

        return sum;
    }
};

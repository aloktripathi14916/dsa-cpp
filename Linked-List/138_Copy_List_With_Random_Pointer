/*
Problem: Copy List with Random Pointer
Platform: LeetCode (LC 138)
Topic: Linked List / HashMap

---------------------------------------------------------

Approach:

Each node contains:
1. next pointer
2. random pointer

We must create a deep copy of the entire list.

Main challenge:
- Random pointers can point anywhere in the list.
- While copying, we need a way to map:
      original node -> copied node

Solution:
Use a HashMap.

Steps:

Phase 1: Create copied nodes
- Traverse original list.
- Create a new node for every original node.
- Store mapping:
      original node -> copied node
- Connect next pointers.

Phase 2: Assign random pointers
- Traverse both lists together.
- For every original node:
      copiedNode->random =
            map[originalNode->random]

This correctly connects all random pointers.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(n)

Example:
Input:
7 -> 13 -> 11 -> 10 -> 1
(random pointers connected arbitrarily)

Output:
Deep copied linked list with identical structure.
*/

/*
// Definition for a Node.
class Node {
public:
    int val;
    Node* next;
    Node* random;

    Node(int _val) {
        val = _val;
        next = NULL;
        random = NULL;
    }
};
*/

class Solution {
public:
    Node* copyRandomList(Node* head) {

        if (head == NULL)
            return NULL;

        unordered_map<Node*, Node*> m;

        // Create head of copied list
        Node* newHead = new Node(head->val);

        Node* oldTemp = head->next;
        Node* newTemp = newHead;

        m[head] = newHead;

        // Phase 1: Copy nodes and next pointers
        while (oldTemp != NULL) {

            Node* copyNode = new Node(oldTemp->val);

            m[oldTemp] = copyNode;

            newTemp->next = copyNode;

            oldTemp = oldTemp->next;
            newTemp = newTemp->next;
        }

        // Phase 2: Copy random pointers
        oldTemp = head;
        newTemp = newHead;

        while (oldTemp != NULL) {

            newTemp->random = m[oldTemp->random];

            oldTemp = oldTemp->next;
            newTemp = newTemp->next;
        }

        return newHead;
    }
};

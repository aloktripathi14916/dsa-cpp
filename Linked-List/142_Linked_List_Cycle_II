/*
Problem: Linked List Cycle II
Platform: LeetCode (LC 142)
Topic: Linked List / Floyd’s Cycle Detection Algorithm

---------------------------------------------------------

Approach:

We use Floyd’s Tortoise and Hare Algorithm
to detect the cycle and find the starting node
of the cycle.

Phase 1: Detect Cycle
- Slow pointer moves 1 step.
- Fast pointer moves 2 steps.
- If they meet, a cycle exists.

Phase 2: Find Cycle Start
- Move slow pointer back to head.
- Keep fast pointer at meeting point.
- Move both one step at a time.
- The node where they meet again
  is the starting node of the cycle.

Why does this work?
- Mathematical property of cycle distances:
  distance(head → cycle start) =
  distance(meeting point → cycle start)

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)

Example:
Input: head = [3,2,0,-4], pos = 1
Output: node with value 2

Explanation:
Tail connects back to node index 1,
so cycle starts at node 2.
*/

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */

class Solution {
public:
    ListNode *detectCycle(ListNode *head) {

        ListNode* slow = head;
        ListNode* fast = head;

        bool isCycle = false;

        // Phase 1: Detect cycle
        while (fast != NULL && fast->next != NULL) {

            slow = slow->next;
            fast = fast->next->next;

            if (slow == fast) {
                isCycle = true;
                break;
            }
        }

        // No cycle exists
        if (!isCycle)
            return NULL;

        // Phase 2: Find cycle starting node
        slow = head;

        while (slow != fast) {

            slow = slow->next;
            fast = fast->next;
        }

        return slow;
    }
};

/*
Problem: Merge Two Sorted Lists
Platform: LeetCode (LC 21)
Topic: Linked List / Recursion

---------------------------------------------------------

Approach:

We merge two sorted linked lists recursively.

Idea:
- Compare the current nodes of both lists.
- The smaller node becomes part of the answer.
- Recursively merge the remaining nodes.

Steps:
1. If one list becomes NULL,
   return the other list.
2. Compare head1->val and head2->val.
3. Attach the smaller node to the result of
   recursive merge of remaining lists.
4. Return the chosen node.

Because both lists are already sorted,
the merged result also remains sorted.

---------------------------------------------------------

Time Complexity: O(n + m)
Space Complexity: O(n + m)
(Recursive call stack)

Example:
Input:
list1 = 1 -> 2 -> 4
list2 = 1 -> 3 -> 4

Output:
1 -> 1 -> 2 -> 3 -> 4 -> 4
*/

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */

class Solution {
public:
    ListNode* mergeTwoLists(ListNode* head1, ListNode* head2) {

        // If one list is empty
        if (head1 == NULL)
            return head2;

        else if (head2 == NULL)
            return head1;

        // Choose smaller node
        if (head1->val <= head2->val) {

            head1->next = mergeTwoLists(head1->next, head2);
            return head1;
        }
        else {

            head2->next = mergeTwoLists(head1, head2->next);
            return head2;
        }
    }
};

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right)
 *     : val(x), left(left), right(right) {}
 * };
 */

/*
Problem: All Elements in Two Binary Search Trees (LC 1305)
Topic: Binary Search Tree / Inorder Traversal / Two Pointers

--------------------------------------------------

Idea:

The inorder traversal of a BST
produces elements in sorted order.

Perform inorder traversal on both
BSTs to obtain two sorted arrays.

Then merge the two sorted arrays
using the same technique used in
Merge Sort.

--------------------------------------------------

Algorithm:

1. Perform inorder traversal of
   root1 and store elements in
   tree1.

2. Perform inorder traversal of
   root2 and store elements in
   tree2.

3. Initialize two pointers:

   i = 0

   j = 0

4. Compare tree1[i] and tree2[j].

   • Push the smaller element into
     the answer.

   • Move the corresponding pointer.

5. If one array finishes, append
   the remaining elements of the
   other array.

6. Return the merged array.

--------------------------------------------------

Example:

Input:

root1:

      2
     / \
    1   4

root2:

      1
     / \
    0   3

Inorder:

tree1 = [1,2,4]

tree2 = [0,1,3]

Merged:

[0,1,1,2,3,4]

--------------------------------------------------

Why It Works?

Inorder traversal of a BST always
returns elements in sorted order.

Since both arrays are sorted, they
can be merged efficiently using
two pointers.

--------------------------------------------------

Time : O(m + n)

Inorder traversal visits every node
once, and merging also takes linear
time.

--------------------------------------------------

Space : O(m + n)

Two inorder arrays and the final
merged array.

--------------------------------------------------

Pattern:

Binary Search Tree
Inorder Traversal
Two Pointers
Merge Two Sorted Arrays
*/

class Solution {
public:

    // Store BST elements in sorted order
    void buildVector(TreeNode* root,
                     vector<int>& tree) {

        if (root == NULL)
            return;

        buildVector(root->left, tree);

        tree.push_back(root->val);

        buildVector(root->right, tree);
    }

    vector<int> getAllElements(TreeNode* root1,
                               TreeNode* root2) {

        vector<int> tree1;
        vector<int> tree2;

        buildVector(root1, tree1);
        buildVector(root2, tree2);

        vector<int> ans;

        int i = 0;
        int j = 0;

        // Merge two sorted arrays
        while (i < tree1.size() &&
               j < tree2.size()) {

            if (tree1[i] <= tree2[j]) {

                ans.push_back(tree1[i]);
                i++;
            }

            else {

                ans.push_back(tree2[j]);
                j++;
            }
        }

        // Remaining elements of tree1
        while (i < tree1.size()) {

            ans.push_back(tree1[i]);
            i++;
        }

        // Remaining elements of tree2
        while (j < tree2.size()) {

            ans.push_back(tree2[j]);
            j++;
        }

        return ans;
    }
};

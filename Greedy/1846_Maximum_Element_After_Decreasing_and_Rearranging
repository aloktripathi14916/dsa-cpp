/*
Problem: Maximum Element After Decreasing and Rearranging (LC 1846)
Topic: Greedy, Sorting

--------------------------------------------------

Idea:

To maximize the largest element:

1. Sort the array.

2. Make the first element equal to 1.

3. Traverse from left to right.

   If the current element is more than
   1 greater than the previous element,
   reduce it to:

       previous + 1

This keeps the array valid while making
the last element as large as possible.

--------------------------------------------------

Time: O(n log n)

Space: O(1)

--------------------------------------------------
*/

class Solution {
public:
    int maximumElementAfterDecrementingAndRearranging(vector<int>& arr) {

        sort(arr.begin(), arr.end());

        // First element must be 1
        if(arr[0] != 1)
            arr[0] = 1;

        // Fix gaps greater than 1
        for(int i = 1; i < arr.size(); i++) {

            if(arr[i] - arr[i - 1] > 1)
                arr[i] = arr[i - 1] + 1;
        }

        return arr.back();
    }
};

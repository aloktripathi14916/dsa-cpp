/*
Problem: Smallest Range I
Platform: LeetCode (LC 908)
Topic: Arrays / Greedy

---------------------------------------------------------

Approach:

Each element can be:
    increased by k
or
    decreased by k

To minimize the range:
- Decrease the maximum element by k
- Increase the minimum element by k

New possible range:
    (max - k) - (min + k)

If this becomes negative,
the minimum possible range is 0.

Steps:
1. Find smallest element.
2. Find largest element.
3. Adjust:
      largest -= k
      smallest += k
4. Return:
      max(0, largest - smallest)

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)

Example:
Input: nums = [1,3,6], k = 3
Output: 0

Explanation:
After adjustment:
1 + 3 = 4
6 - 3 = 3

Range becomes max(0, 3 - 4) = 0
*/

class Solution {
public:
    int smallestRangeI(vector<int>& nums, int k) {

        int small = INT_MAX;
        int big = INT_MIN;

        // Find minimum element
        for (int i = 0; i < nums.size(); i++) {

            if (nums[i] < small) {
                small = nums[i];
            }
        }

        // Find maximum element
        for (int i = 0; i < nums.size(); i++) {

            if (nums[i] > big) {
                big = nums[i];
            }
        }

        // Adjust range
        big = big - k;
        small = small + k;

        return max(0, big - small);
    }
};

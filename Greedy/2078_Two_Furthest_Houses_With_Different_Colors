/*
Problem: Two Furthest Houses With Different Colors
Platform: LeetCode (LC 2078)
Topic: Arrays / Greedy

---------------------------------------------------------

Approach:

We need to find the maximum distance:

    |i - j|

such that:
    colors[i] != colors[j]

Observation:

The maximum distance must involve
either:
1. The first house
2. The last house

Why?
- To maximize distance, one endpoint should
  be as far left or as far right as possible.

So we check:

Case 1:
Find the farthest house from the right
whose color differs from colors[0].

Distance:
    j - 0 = j

Case 2:
Find the farthest house from the left
whose color differs from colors[n-1].

Distance:
    (n - 1) - i

The answer is the maximum of these two.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)

Example:
Input:
colors = [1,1,1,6,1,1,1]

Output:
3

Explanation:
House 0 has color 1.
House 3 has color 6.

Distance = 3.
*/

class Solution {
public:
    int maxDistance(vector<int>& colors) {

        int n = colors.size();

        int ans = 0;

        // Farthest house from the right
        // different from first house
        for (int j = n - 1; j >= 0; j--) {

            if (colors[j] != colors[0]) {

                ans = max(ans, j);
                break;
            }
        }

        // Farthest house from the left
        // different from last house
        for (int i = 0; i < n; i++) {

            if (colors[i] != colors[n - 1]) {

                ans = max(ans, n - 1 - i);
                break;
            }
        }

        return ans;
    }
};

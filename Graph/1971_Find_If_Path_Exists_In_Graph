/*
Problem: Find if Path Exists in Graph (LC 1971)
Topic: Graph, BFS

--------------------------------------------------

Idea:

Treat the edges as an undirected graph.

1. Build an adjacency list.

2. Perform a BFS starting from the
   source node.

3. Mark visited nodes to avoid
   revisiting them.

4. If the destination node is reached,
   a valid path exists.

Otherwise, after BFS finishes, no path
exists.

--------------------------------------------------

Time: O(V + E)

V = number of vertices
E = number of edges

Space: O(V + E)

(Adjacency list, queue, visited array.)

--------------------------------------------------
*/

class Solution {
public:
    bool validPath(int n, vector<vector<int>>& edges,
                   int source, int destination) {

        vector<vector<int>> adj(n);

        // Build adjacency list
        for(auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        queue<int> q;
        vector<bool> vis(n, false);

        q.push(source);
        vis[source] = true;

        while(!q.empty()) {

            int u = q.front();
            q.pop();

            if(u == destination)
                return true;

            for(int v : adj[u]) {

                if(!vis[v]) {
                    vis[v] = true;
                    q.push(v);
                }
            }
        }

        return false;
    }
};

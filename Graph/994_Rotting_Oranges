/*
Problem: Rotting Oranges (LC 994)
Topic: Graph, Multi-Source BFS

--------------------------------------------------

Idea:

Initially, all rotten oranges are
sources of infection.

Push every rotten orange into the
queue with time = 0.

Perform a multi-source BFS:

• At each step, rot all adjacent fresh
  oranges.

• Mark them visited and push them into
  the queue with time + 1.

The maximum time encountered during
BFS is the answer.

After BFS, if any fresh orange remains
unvisited, it can never rot.

Return -1 in that case.

--------------------------------------------------

Time: O(n × m)

Each cell is processed at most once.

Space: O(n × m)

Queue + visited array.

--------------------------------------------------
*/

class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {

        int n = grid.size();
        int m = grid[0].size();

        vector<vector<bool>> vis(n,
                                 vector<bool>(m, false));

        queue<pair<pair<int,int>, int>> q;

        // Push all initially rotten oranges
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {

                if(grid[i][j] == 2) {
                    q.push({{i, j}, 0});
                    vis[i][j] = true;
                }
            }
        }

        int ans = 0;

        while(!q.empty()) {

            int i = q.front().first.first;
            int j = q.front().first.second;
            int time = q.front().second;
            q.pop();

            ans = max(ans, time);

            // Up
            if(i - 1 >= 0 && !vis[i - 1][j] &&
               grid[i - 1][j] == 1) {

                q.push({{i - 1, j}, time + 1});
                vis[i - 1][j] = true;
            }

            // Right
            if(j + 1 < m && !vis[i][j + 1] &&
               grid[i][j + 1] == 1) {

                q.push({{i, j + 1}, time + 1});
                vis[i][j + 1] = true;
            }

            // Down
            if(i + 1 < n && !vis[i + 1][j] &&
               grid[i + 1][j] == 1) {

                q.push({{i + 1, j}, time + 1});
                vis[i + 1][j] = true;
            }

            // Left
            if(j - 1 >= 0 && !vis[i][j - 1] &&
               grid[i][j - 1] == 1) {

                q.push({{i, j - 1}, time + 1});
                vis[i][j - 1] = true;
            }
        }

        // Check for unreachable fresh oranges
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {

                if(grid[i][j] == 1 && !vis[i][j])
                    return -1;
            }
        }

        return ans;
    }
};

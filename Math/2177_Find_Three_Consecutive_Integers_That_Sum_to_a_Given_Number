/*
Problem: Find Three Consecutive Integers That Sum to a Given Number (LC 2177)
Topic: Math

--------------------------------------------------

Idea:

Let the three consecutive integers be:

x - 1, x, x + 1

Their sum is:

(x - 1) + x + (x + 1) = 3x

Therefore:

x = num / 3

A solution exists only if num is
divisible by 3.

Return:

[x - 1, x, x + 1]

Otherwise, return an empty vector.

--------------------------------------------------

Time: O(1)

Space: O(1)

--------------------------------------------------
*/

class Solution {
public:
    vector<long long> sumOfThree(long long num) {

        vector<long long> ans;

        if(num % 3 == 0) {

            long long x = num / 3;

            ans.push_back(x - 1);
            ans.push_back(x);
            ans.push_back(x + 1);
        }

        return ans;
    }
};

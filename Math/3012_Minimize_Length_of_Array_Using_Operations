
/*
Problem: Minimize Length of Array Using Operations
LeetCode: 3012

--------------------------------------------------

Idea:
1. Find the minimum element.
2. If any element is not divisible by the minimum,
   the answer is 1.
3. Otherwise, only occurrences of the minimum matter.
   Every operation can combine two minimum elements,
   so the final length is ceil(count / 2).

--------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)
*/

class Solution {
public:
    int minimumArrayLength(vector<int>& nums) {
        int mi = *min_element(nums.begin(), nums.end());
        int count = 0;

        for (int x : nums) {
            // If an element is not divisible by the minimum,
            // we can reduce the array to length 1.
            if (x % mi != 0)
                return 1;

            if (x == mi)
                count++;
        }

        // ceil(count / 2)
        return (count + 1) / 2;
    }
};

/*
Problem: Sequential Digits (LC 1291)
Topic: Number Construction

--------------------------------------------------

Idea:

A sequential-digit number has digits that
increase by exactly 1.

Examples:

    123
    234
    4567
    789

For every possible starting digit:

1. Start with an empty number.
2. Keep appending consecutive digits.
3. Whenever the number lies inside [low, high],
   add it to the answer.

Finally, sort the generated numbers.

--------------------------------------------------

Time: O(1)

There are only a small fixed number of
sequential-digit numbers.

Space: O(1)

The number of possible answers is bounded.

--------------------------------------------------
*/

class Solution {
public:
    vector<int> sequentialDigits(int low, int high) {

        vector<int> ans;

        for(int start = 1; start <= 9; start++) {

            int num = 0;

            for(int digit = start; digit <= 9; digit++) {

                num = num * 10 + digit;

                if(num >= low && num <= high)
                    ans.push_back(num);
            }
        }

        sort(ans.begin(), ans.end());

        return ans;
    }
};

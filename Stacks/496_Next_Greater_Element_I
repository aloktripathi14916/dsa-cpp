/*
Problem: Next Greater Element I
Platform: LeetCode (LC 496)
Topic: Stack / Monotonic Stack

---------------------------------------------------------

Approach:

For every element in nums1,
we need to find the first greater element
to its right in nums2.

Efficient idea:
Use a Monotonic Decreasing Stack.

We process nums2 from right to left.

Why?
- Stack keeps possible "next greater elements".
- Smaller elements are useless once a bigger
  element appears, so we remove them.

Steps:
1. Traverse nums2 from right to left.
2. Remove all stack elements <= current element.
3. If stack becomes empty:
      next greater = -1
   Else:
      next greater = stack top
4. Store mapping:
      current element -> next greater
5. Push current element into stack.
6. Build answer for nums1 using hashmap.

---------------------------------------------------------

Time Complexity: O(n + m)
n = size of nums2
m = size of nums1

Space Complexity: O(n)

Example:
Input:
nums1 = [4,1,2]
nums2 = [1,3,4,2]

Output:
[-1,3,-1]

Explanation:
4 → no greater element
1 → next greater is 3
2 → no greater element
*/

class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1,
                                   vector<int>& nums2) {

        unordered_map<int, int> m;

        stack<int> s;

        // Process nums2 from right to left
        for (int i = nums2.size() - 1; i >= 0; i--) {

            // Remove smaller/equal elements
            while (s.size() > 0 && s.top() <= nums2[i]) {
                s.pop();
            }

            // No greater element exists
            if (s.empty()) {
                m[nums2[i]] = -1;
            }

            // Next greater element
            else {
                m[nums2[i]] = s.top();
            }

            // Push current element
            s.push(nums2[i]);
        }

        vector<int> ans;

        // Build answer for nums1
        for (int i = 0; i < nums1.size(); i++) {

            ans.push_back(m[nums1[i]]);
        }

        return ans;
    }
};

/*
Problem: Evaluate Reverse Polish Notation
Platform: LeetCode (LC 150)
Topic: Stack

---------------------------------------------------------

Approach:

Reverse Polish Notation (Postfix Expression)
stores operators after their operands.

Example:

    ["2","1","+","3","*"]

Represents:

    (2 + 1) * 3

---------------------------------------------------------

Stack Idea:

1. If the token is a number:
      Push it onto the stack.

2. If the token is an operator:
      Pop the top two numbers.

      Let:
          b = first popped
          a = second popped

      Perform:

          a operator b

      Push the result back.

The order is important for:
- subtraction
- division

Example:

Stack:
[4, 2]

Operator: "/"

Result:

    4 / 2 = 2

NOT

    2 / 4

---------------------------------------------------------

Example Walkthrough:

Input:

["2","1","+","3","*"]

Process:

Push 2
Stack: [2]

Push 1
Stack: [2,1]

'+'
2 + 1 = 3

Stack: [3]

Push 3
Stack: [3,3]

'*'
3 * 3 = 9

Stack: [9]

Output:
9

---------------------------------------------------------

Time Complexity: O(n)

Each token is processed once.

Space Complexity: O(n)

Stack may store all operands.

---------------------------------------------------------
*/

class Solution {
public:
    int evalRPN(vector<string>& tokens) {

        stack<int> s;

        for (int i = 0; i < tokens.size(); i++) {

            if (s.size() > 0 &&
                (tokens[i] == "+" ||
                 tokens[i] == "-" ||
                 tokens[i] == "*" ||
                 tokens[i] == "/")) {

                int b = s.top();
                s.pop();

                int a = s.top();
                s.pop();

                if (tokens[i] == "+")
                    s.push(a + b);

                else if (tokens[i] == "-")
                    s.push(a - b);

                else if (tokens[i] == "*")
                    s.push(a * b);

                else
                    s.push(a / b);
            }
            else {

                s.push(stoi(tokens[i]));
            }
        }

        return s.top();
    }
};

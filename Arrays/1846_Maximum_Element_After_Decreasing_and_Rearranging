
/*
Problem: Maximum Element After Decreasing and Rearranging
LeetCode: 1846

--------------------------------------------------

Idea:
1. Sort the array.
2. The first element must be 1.
3. For every next element, make sure the difference
   from the previous element is at most 1.
4. If the gap is larger than 1, reduce the current
   element to previous + 1.
5. The final element will be the maximum possible value.

--------------------------------------------------

Time Complexity: O(n log n)
Space Complexity: O(1) extra
*/

class Solution {
public:
    int maximumElementAfterDecrementingAndRearranging(vector<int>& arr) {
        sort(arr.begin(), arr.end());

        arr[0] = 1;

        for (int i = 1; i < arr.size(); i++) {
            if (arr[i] - arr[i - 1] > 1)
                arr[i] = arr[i - 1] + 1;
        }

        return arr.back();
    }
};

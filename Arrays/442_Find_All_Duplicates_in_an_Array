/*
Problem: Find All Duplicates in an Array
Platform: LeetCode (LC 442)
Topic: Arrays / Index Marking

---------------------------------------------------------

Approach:

Given:
- Numbers are in the range [1, n]
- Some numbers appear twice

We use the array itself to mark whether
a number has been seen before.

Key Idea:
For a value x,
its corresponding index is:

    index = x - 1

Steps:
1. Traverse the array.
2. For each number:
      idx = abs(nums[i]) - 1
3. If nums[idx] is already negative:
      the number has been seen before,
      so it is a duplicate.
4. Otherwise:
      mark it as visited by making
      nums[idx] negative.
5. Return all duplicates found.

Why abs()?
- Elements may already be negative due to
  previous markings.
- abs() recovers the original value.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)
(Excluding output vector)

Example:
Input:
nums = [4,3,2,7,8,2,3,1]

Process:
2 appears twice
3 appears twice

Output:
[2,3]
*/

class Solution {
public:
    vector<int> findDuplicates(vector<int>& nums) {

        vector<int> ans;

        for (int i = 0; i < nums.size(); i++) {

            int idx = abs(nums[i]) - 1;

            // Already visited -> duplicate
            if (nums[idx] < 0) {

                ans.push_back(abs(nums[i]));
            }

            // Mark as visited
            else {

                nums[idx] = -nums[idx];
            }
        }

        return ans;
    }
};

/*
Problem: Maximum Product of Three Numbers
Platform: LeetCode (LC 628)
Topic: Arrays / Greedy

---------------------------------------------------------

Approach:

The maximum product of three numbers can come from:

Case 1:
Three largest numbers
    max1 * max2 * max3

Case 2:
Two smallest (most negative) numbers
and the largest positive number
    min1 * min2 * max1

Why Case 2?
- Product of two negative numbers is positive.
- Two very small negative values can produce
  a larger product than using the third-largest
  positive number.

Example:
[-10, -10, 5, 2]

5 * 2 * (-10) = -100

(-10) * (-10) * 5 = 500

So we must consider both cases.

Steps:
1. Track:
      max1, max2, max3
      min1, min2
2. Traverse the array once and update them.
3. Return:
      max(max1*max2*max3,
          min1*min2*max1)

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)

Example:
Input:
nums = [-10,-10,5,2]

Output:
500

Explanation:
Maximum product is:
(-10) × (-10) × 5 = 500
*/

class Solution {
public:
    int maximumProduct(vector<int>& nums) {

        long max1 = LONG_MIN;
        long max2 = LONG_MIN;
        long max3 = LONG_MIN;

        long min1 = LONG_MAX;
        long min2 = LONG_MAX;

        for (int x : nums) {

            // Update largest three numbers
            if (x > max1) {

                max3 = max2;
                max2 = max1;
                max1 = x;
            }
            else if (x > max2) {

                max3 = max2;
                max2 = x;
            }
            else if (x > max3) {

                max3 = x;
            }

            // Update smallest two numbers
            if (x < min1) {

                min2 = min1;
                min1 = x;
            }
            else if (x < min2) {

                min2 = x;
            }
        }

        return max(max1 * max2 * max3,
                   min1 * min2 * max1);
    }
};

/*
Problem: Longest Balanced Substring
Platform: LeetCode (LC 3900)
Topic: Prefix Sum / HashMap

---------------------------------------------------------

Approach:

A balanced substring contains:
    equal number of '0's and '1's

We convert the problem into a prefix sum problem.

Transformation:
- Treat '1' as +1
- Treat '0' as -1

Key observation:
If two prefix sums are equal,
then the substring between them has
equal number of 0s and 1s.

Data Structure:
HashMap:
    prefixSum -> first occurrence index

Steps:
1. Initialize:
      first[0] = -1
2. Traverse string:
      '1' -> +1
      '0' -> -1
3. If current sum appeared before:
      balanced substring exists
      update maximum length
4. Otherwise store first occurrence.

Extra calculation:
- Maximum possible balanced length is:
      2 * min(count(0), count(1))

This acts as an upper bound.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(n)

Example:
Input: s = "110100"

Output: 6

Explanation:
Entire string contains
3 zeros and 3 ones,
so whole string is balanced.
*/

class Solution {
public:
    int longestBalanced(string s) {

        int n = s.size();

        unordered_map<int, int> first;

        first[0] = -1;

        int sum = 0;
        int ans = 0;

        // Prefix sum traversal
        for (int i = 0; i < n; i++) {

            if (s[i] == '1')
                sum += 1;
            else
                sum -= 1;

            // Balanced substring found
            if (first.count(sum)) {

                ans = max(ans, i - first[sum]);
            }

            // Store first occurrence
            else {

                first[sum] = i;
            }
        }

        // Count total zeros and ones
        int zeros = count(s.begin(), s.end(), '0');
        int ones = n - zeros;

        // Maximum possible balanced length
        int maxPossible = 2 * min(zeros, ones);

        if (ans == maxPossible)
            return ans;

        return maxPossible;
    }
};

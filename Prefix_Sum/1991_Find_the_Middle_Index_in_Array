/*
Problem: Find the Middle Index in Array
Platform: LeetCode (LC 1991)
Topic: Prefix Sum / Arrays

---------------------------------------------------------

Approach:

The middle index is the index where:
    sum of elements on left == sum of elements on right

We avoid recalculating sums repeatedly by using
the total sum of the array.

Steps:
1. Compute total sum of all elements.
2. Maintain a running left sum.
3. For every index:
       right sum = total - left sum - nums[i]
4. If left sum == right sum,
       return current index.
5. Otherwise update left sum and continue.

This gives an efficient single traversal solution.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(1)

Example:
Input: nums = [2,3,-1,8,4]
Output: 3

Explanation:
Left sum at index 3:
2 + 3 + (-1) = 4

Right sum at index 3:
4

Both are equal.
*/

class Solution {
public:
    int findMiddleIndex(vector<int>& nums) {

        int total = 0;

        // Calculate total sum
        for (int i = 0; i < nums.size(); i++) {
            total += nums[i];
        }

        int leftsum = 0;
        int rightsum = 0;

        for (int i = 0; i < nums.size(); i++) {

            rightsum = total - leftsum - nums[i];

            if (leftsum == rightsum)
                return i;

            leftsum += nums[i];
        }

        return -1;
    }
};

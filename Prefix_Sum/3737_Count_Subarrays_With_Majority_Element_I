/*
Problem: Count Majority Subarrays (LC 3737)
Topic: Brute Force, Prefix Sum

--------------------------------------------------

Idea:

Convert:
• target -> +1
• others -> -1

Now,

sum = (#target) - (#others)

If sum > 0, the target appears more
times than all other elements combined,
so it is the majority.

Check every subarray and count those
with positive sum.

--------------------------------------------------

Time: O(n²)

Space: O(1)

--------------------------------------------------

*/

class Solution {
public:
    int countMajoritySubarrays(vector<int>& nums, int target) {

        // Convert target to +1 and others to -1
        for(int i = 0; i < nums.size(); i++) {
            nums[i] = (nums[i] == target) ? 1 : -1;
        }

        int count = 0;

        // Check every subarray
        for(int i = 0; i < nums.size(); i++) {

            int sum = 0;

            for(int j = i; j < nums.size(); j++) {

                sum += nums[j];

                if(sum > 0)
                    count++;
            }
        }

        return count;
    }
};

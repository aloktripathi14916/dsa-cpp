/*
Problem: Intervals Between Identical Elements
Platform: LeetCode (LC 2121)
Topic: HashMap / Prefix Sum

---------------------------------------------------------

Approach:

For every index i, compute:

    ans[i] = Σ |i - j|

for all indices j where:

    nums[i] == nums[j]

Brute Force:
- For each index, check all other indices.
- Time Complexity: O(n²)
- Too slow for large inputs.

Optimized Idea:

1. Group all indices having the same value.

Example:
nums = [2,1,3,1,2,3,3]

Groups:

2 -> [0,4]
1 -> [1,3]
3 -> [2,5,6]

2. For each group of indices:
   Build a prefix sum array of indices.

Example:

Indices = [2,5,6]

Prefix = [2,7,13]

3. For an occurrence at position i:

Distance to left indices:

    left =
    i * idx[i] - prefix[i-1]

Distance to right indices:

    right =
    (prefix[last] - prefix[i])
    - (countRight * idx[i])

Total contribution:

    ans[idx[i]] = left + right

Using prefix sums allows each index's answer
to be computed in O(1).

---------------------------------------------------------

Time Complexity: O(n)

- Build hashmap: O(n)
- Build prefix sums: O(n)
- Compute answers: O(n)

Total: O(n)

Space Complexity: O(n)

---------------------------------------------------------

Example:

Input:
nums = [2,1,3,1,2,3,3]

Output:
[4,2,7,2,4,4,5]

Explanation:

Index 0 (value 2):
|0-4| = 4

Index 2 (value 3):
|2-5| + |2-6|
= 3 + 4
= 7

And similarly for the remaining indices.
*/

class Solution {
public:
    vector<long long> getDistances(vector<int>& nums) {

        int n = nums.size();

        vector<long long> ans(n, 0);

        unordered_map<int, vector<int>> mp;

        // Store indices of each value
        for (int i = 0; i < n; i++) {

            mp[nums[i]].push_back(i);
        }

        // Process each value group
        for (auto &p : mp) {

            vector<int>& idx = p.second;

            int m = idx.size();

            // Prefix sums of indices
            vector<long long> prefix(m, 0);

            prefix[0] = idx[0];

            for (int i = 1; i < m; i++) {

                prefix[i] =
                    prefix[i - 1] + idx[i];
            }

            // Compute distance for each occurrence
            for (int i = 0; i < m; i++) {

                long long left = 0;
                long long right = 0;

                // Contribution from left side
                if (i > 0) {

                    left =
                        (long long)i * idx[i]
                        - prefix[i - 1];
                }

                // Contribution from right side
                if (i < m - 1) {

                    right =
                        (prefix[m - 1] - prefix[i])
                        - (long long)(m - i - 1)
                              * idx[i];
                }

                ans[idx[i]] = left + right;
            }
        }

        return ans;
    }
};

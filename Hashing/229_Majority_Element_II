/*
Problem: Majority Element II
Platform: LeetCode (LC 229)
Topic: HashMap / Arrays

---------------------------------------------------------

Approach:

We need to find all elements that appear
more than:

    n / 3

times in the array.

Observation:

There can be at most two such elements.

Why?

If three different elements each appeared
more than n/3 times, their total frequency
would exceed n, which is impossible.

---------------------------------------------------------

HashMap Idea:

1. Count the frequency of every element
   using a hashmap.

2. Traverse the array:
      - If frequency of nums[i] is greater
        than n/3, add it to the answer.

3. Remove the element from the hashmap
   after adding it to avoid duplicates.

---------------------------------------------------------

Example:

Input:

nums = [3,2,3]

Frequency Map:

3 -> 2
2 -> 1

n = 3

Threshold:

n/3 = 1

Elements with frequency > 1:

3

Output:

[3]

---------------------------------------------------------

Example 2:

Input:

nums = [1,1,1,3,3,2,2,2]

Frequency:

1 -> 3
2 -> 3
3 -> 2

n = 8

Threshold:

8/3 = 2

Elements appearing more than 2 times:

1, 2

Output:

[1,2]

---------------------------------------------------------

Time Complexity: O(n)

- Frequency counting: O(n)
- Traversal: O(n)

Space Complexity: O(n)

(HashMap stores frequencies)

Note:
A more optimal solution exists using
Boyer-Moore Voting Algorithm with
O(1) extra space.
*/

class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {

        int n = nums.size();

        vector<int> ans;

        unordered_map<int, int> mp;

        // Count frequencies
        for (int i = 0; i < n; i++) {

            mp[nums[i]]++;
        }

        // Collect elements with freq > n/3
        for (int i = 0; i < n; i++) {

            if (mp[nums[i]] > n / 3) {

                ans.push_back(nums[i]);

                // Avoid duplicates
                mp.erase(nums[i]);
            }
        }

        return ans;
    }
};

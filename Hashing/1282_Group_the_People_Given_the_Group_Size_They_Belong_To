/*
Problem: Group the People Given the Group Size They Belong To (LC 1282)
Topic: Hash Map

--------------------------------------------------

Idea:

People with the same required group
size are collected together.

Maintain a hash map:

    group size → current members

For each person:

• Add their index to the corresponding
  group.

• Once the group's size becomes equal
  to the required group size, the
  group is complete.

• Add it to the answer and clear the
  temporary vector to start forming
  the next group of the same size.

--------------------------------------------------

Time: O(n)

Space: O(n)

--------------------------------------------------
*/

class Solution {
public:
    vector<vector<int>> groupThePeople(vector<int>& groupSizes) {

        unordered_map<int, vector<int>> mp;
        vector<vector<int>> ans;

        for(int i = 0; i < groupSizes.size(); i++) {

            mp[groupSizes[i]].push_back(i);

            if(mp[groupSizes[i]].size() == groupSizes[i]) {

                ans.push_back(mp[groupSizes[i]]);
                mp[groupSizes[i]].clear();
            }
        }

        return ans;
    }
};

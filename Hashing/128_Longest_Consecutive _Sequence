/*
Problem: Longest Consecutive Sequence
Platform: LeetCode (LC 128)
Topic: HashSet / Arrays

---------------------------------------------------------

Approach:

We need to find the length of the longest sequence
of consecutive integers.

A sorting approach works in O(n log n),
but we can optimize to O(n) using a HashSet.

Key idea:
Only start counting when the current number is
the beginning of a sequence.

How to identify sequence start?
- If (num - 1) does NOT exist in the set,
  then num is the starting element.

From there:
- Keep checking num+1, num+2, ...
- Count sequence length.
- Update maximum length.

Using unordered_set allows O(1) average lookup time.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(n)

Example:
Input: nums = [100,4,200,1,3,2]
Output: 4

Explanation:
Longest consecutive sequence:
[1,2,3,4]
Length = 4
*/

class Solution {
public:
    int longestConsecutive(vector<int>& nums) {

        unordered_set<int> st(nums.begin(), nums.end());

        int maxlen = 0;

        for (auto num : st) {

            // Start only from beginning of sequence
            if (st.find(num - 1) == st.end()) {

                int current = num;
                int length = 1;

                // Expand consecutive sequence
                while (st.find(current + 1) != st.end()) {
                    current++;
                    length++;
                }

                maxlen = max(maxlen, length);
            }
        }

        return maxlen;
    }
};

/*
Problem: Minimum Distance
Platform: LeetCode (LC 3741)
Topic: HashMap / Arrays

---------------------------------------------------------

Approach:

We need to find the minimum distance expression
for any number appearing at least three times.

For indices:
    a < b < c

Distance formula:
    (c - a) + (c - b) + (b - a)

Observation:
- We only need the latest two occurrences
  of every number while traversing the array.
- When the same number appears again,
  we compute the expression using:
        previous two indices + current index

Data Structure:
HashMap:
    number -> {second last index, last index}

Steps:
1. Traverse array.
2. If number appears first time:
      store current index.
3. If second occurrence:
      shift indices accordingly.
4. If third or later occurrence:
      compute distance expression.
      update minimum answer.
      shift stored indices.

If no valid triplet exists,
return -1.

---------------------------------------------------------

Time Complexity: O(n)
Space Complexity: O(n)

Example:
Input: nums = [1,2,1,1]
Output: 4

Explanation:
Indices of 1 are:
0, 2, 3

Distance:
(3 - 0) + (3 - 2) + (2 - 0)
= 3 + 1 + 2
= 6
*/

class Solution {
public:
    int minimumDistance(vector<int>& nums) {

        unordered_map<int, pair<int, int>> mp;

        int ans = INT_MAX;

        for (int i = 0; i < nums.size(); i++) {

            int x = nums[i];

            // First occurrence
            if (mp.find(x) == mp.end()) {

                mp[x] = {-1, i};
            }

            else {

                auto &p = mp[x];

                // Second occurrence
                if (p.first == -1) {

                    p.first = p.second;
                    p.second = i;
                }

                else {

                    int a = p.first;
                    int b = p.second;
                    int c = i;

                    // Compute distance expression
                    ans = min(ans,
                              (c - a) + (c - b) + (b - a));

                    // Shift indices
                    p.first = p.second;
                    p.second = i;
                }
            }
        }

        return ans == INT_MAX ? -1 : ans;
    }
};

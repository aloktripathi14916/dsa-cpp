/*
Problem: Intersection of Two Arrays II
Platform: LeetCode (LC 350)
Topic: HashMap / Arrays

---------------------------------------------------------

Approach:

We need to find the intersection of two arrays,
including duplicate occurrences.

Example:

nums1 = [1,2,2,1]
nums2 = [2,2]

Output:
[2,2]

The number 2 appears twice in both arrays,
so it should appear twice in the answer.

---------------------------------------------------------

HashMap Idea:

1. Count the frequency of every element
   in nums1.

2. Traverse nums2:
      - If the current element exists in the
        hashmap with frequency > 0:
            add it to the answer.
            decrease its frequency.

This ensures:
- Each element is used only as many times
  as it appears in nums1.
- Duplicates are handled correctly.

---------------------------------------------------------

Time Complexity: O(n + m)

n = nums1.size()
m = nums2.size()

Space Complexity: O(min(n, m))

---------------------------------------------------------

Example:

Input:
nums1 = [4,9,5]
nums2 = [9,4,9,8,4]

Frequency Map:
4 -> 1
9 -> 1
5 -> 1

Traverse nums2:

9 -> present → add
4 -> present → add
9 -> frequency 0 → skip
8 -> absent → skip
4 -> frequency 0 → skip

Output:
[9,4]
*/

class Solution {
public:
    vector<int> intersect(vector<int>& nums1,
                          vector<int>& nums2) {

        unordered_map<int, int> freq;

        vector<int> ans;

        // Count frequencies of nums1
        for (int i = 0; i < nums1.size(); i++) {

            freq[nums1[i]]++;
        }

        // Find common elements
        for (int j = 0; j < nums2.size(); j++) {

            if (freq[nums2[j]] > 0) {

                ans.push_back(nums2[j]);

                freq[nums2[j]]--;
            }
        }

        return ans;
    }
};
